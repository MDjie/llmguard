# GuardLLM 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接 URL
DATABASE_URL=postgres://guardllm:replace-with-a-strong-password@localhost:5432/guardllm
# Loopback development may disable TLS. Remote production databases must use
# verify-full and, when needed, an enterprise CA injected by the secret manager.
DATABASE_SSL_MODE=disable
# Docker Compose uses this exact hostname allowlist for its private bridge only.
# Never add public or remote database hosts here.
DATABASE_PLAINTEXT_ALLOWED_HOSTS=postgres
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# 数据库用户名（Docker Compose 使用）
DB_USER=guardllm

# 数据库密码（Docker Compose 使用，生产环境请修改）
DB_PASSWORD=replace-with-a-strong-password

# 数据库名称
DB_NAME=guardllm

# 数据库端口（Docker Compose 使用）
DB_PORT=5432

# ==================== 应用配置 ====================
# 应用端口
PORT=5000
APP_PORT=58082
# 默认仅本机访问。局域网部署时显式设置服务器内网 IP，或按需设置 0.0.0.0。
APP_BIND_HOST=127.0.0.1

# 运行环境
NODE_ENV=production
# Local Compose defaults to 127.0.0.1 over HTTP. Set true behind HTTPS.
SESSION_COOKIE_SECURE=false
# Development only. Production ignores this flag and keeps lab routes disabled.
GUARDLLM_ENABLE_EXPERIMENTAL_LABS=false

# ==================== 安全配置 ====================
# JWT 签名密钥（至少 32 字节；生产环境必须由 Secret 管理系统注入）
JWT_SECRET=replace-with-at-least-32-random-bytes

# Provider 密钥信封加密（32 字节随机值的 base64 与版本 ID）
SECRET_MASTER_KEY=
SECRET_MASTER_KEY_ID=local-v1

# 额外允许的外部 Provider 主机；只填精确主机名，不填 URL
PROVIDER_ALLOWED_HOSTS=

# 私网 Provider 精确主机名；仅这些主机允许 HTTP/私网地址，例如内网 Ollama DNS 名
PROVIDER_ALLOWED_PRIVATE_HOSTS=

# 首次管理员创建（只供 pnpm auth:bootstrap 使用，执行后从环境中移除密码）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# ==================== 可选配置 ====================
# 日志级别
LOG_LEVEL=info
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes

# 是否启用调试模式
DEBUG=false
CONTENT_HASH_KEY=replace-with-at-least-32-random-bytes
# Independent HMAC key for stable, irreversible DLP tokenization. Do not reuse other keys.
DLP_TOKENIZATION_HMAC_KEY=replace-with-independent-at-least-32-random-bytes
# Independent HMAC key and rotation identifier for the append-only audit chain.
AUDIT_CHAIN_KEY=replace-with-at-least-32-random-bytes
AUDIT_CHAIN_KEY_ID=audit-hmac-v1
# JSON key ring used only by the verifier during key rotation, for example {"audit-hmac-v0":"..."}.
AUDIT_CHAIN_KEYS_JSON=
# Enterprise trusted timestamp service. Public key and bearer token are Secret-managed.
TRUSTED_TIMESTAMP_ENDPOINT=
TRUSTED_TIMESTAMP_PUBLIC_KEY_PEM=
TRUSTED_TIMESTAMP_KEY_FINGERPRINT=
TRUSTED_TIMESTAMP_BEARER_TOKEN=
AUDIT_TIMESTAMP_BATCH_SIZE=20
AUDIT_TIMESTAMP_WORKER_IDLE_MS=60000
# Optional durable audit export. In production, Syslog and Kafka transport must use TLS.
AUDIT_EXPORT_EVENT_PREFIXES=
AUDIT_EXPORT_OUTCOMES=DENIED,ERROR
AUDIT_EXPORT_MAX_ATTEMPTS=10
AUDIT_EXPORT_POLL_MS=1000
AUDIT_EXPORT_SYSLOG_HOST=
AUDIT_EXPORT_SYSLOG_PORT=6514
AUDIT_EXPORT_SYSLOG_PROTOCOL=tls
AUDIT_EXPORT_SYSLOG_TLS_CA_PATH=
AUDIT_EXPORT_SYSLOG_TLS_CERT_PATH=
AUDIT_EXPORT_SYSLOG_TLS_KEY_PATH=
AUDIT_EXPORT_KAFKA_BROKERS=
AUDIT_EXPORT_KAFKA_TOPIC=guardllm.audit.v1
AUDIT_EXPORT_KAFKA_CLIENT_ID=guardllm-audit-exporter
AUDIT_EXPORT_KAFKA_SSL=true
AUDIT_EXPORT_KAFKA_TLS_CA_PATH=
AUDIT_EXPORT_KAFKA_TLS_CERT_PATH=
AUDIT_EXPORT_KAFKA_TLS_KEY_PATH=
AUDIT_EXPORT_KAFKA_SASL_MECHANISM=
AUDIT_EXPORT_KAFKA_SASL_USERNAME=
AUDIT_EXPORT_KAFKA_SASL_PASSWORD=
# Local-account password expiry; enterprise SSO policies are enforced by the customer IdP.
PASSWORD_MAX_AGE_DAYS=90
# GB 45438-2025 generated-content marking. Provider code must match the registered service identity.
CONTENT_MARKING_KEY=replace-with-at-least-32-random-bytes
CONTENT_MARKING_KEY_ID=content-mark-hmac-v1
CONTENT_MARKING_PROVIDER_CODE=replace-with-registered-provider-code
CONTENT_MARKING_VISIBLE_LABEL=[AI生成合成内容]
# Ed25519 PEM keys used to sign policy bundles in the control plane and verify them in the data plane.
# Store the private key only in the control-plane secret manager. Encode line breaks as \\n in .env files.
POLICY_SIGNING_PRIVATE_KEY=
POLICY_SIGNING_PUBLIC_KEY=
# File-based injection is preferred. Runtime App/Workers receive only the public file.
# The private file is for an isolated signer/bootstrap process and must not enter runtime containers.
POLICY_SIGNING_PRIVATE_KEY_FILE=
POLICY_SIGNING_PUBLIC_KEY_FILE=
POLICY_SIGNING_KEY_ID=local-ed25519-v1
# Last-known-good fallback is allowed only for transient database failures and only within this TTL.
POLICY_LKG_MAX_AGE_MS=300000
# Use local-compose only for the loopback development deployment.
GUARDLLM_DEPLOYMENT_PROFILE=local-compose
POLICY_GATE_MIN_CASES=2000
POLICY_GATE_MIN_ACCURACY=95
POLICY_GATE_MIN_RECALL=95
POLICY_GATE_MAX_FPR=1
POLICY_GATE_MAX_FNR=5
# Independent HMAC key for RAG source/chunk provenance signatures.
RAG_PROVENANCE_KEY=replace-with-at-least-32-random-bytes
# Short-lived Tool/MCP permit token signing key.
TOOL_PERMIT_KEY=replace-with-at-least-32-random-bytes

# S3-compatible object storage (MinIO is supported). Hosts must be explicitly allowlisted.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=guard-artifacts
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_ALLOWED_HOSTS=
OBJECT_STORE_ALLOWED_PRIVATE_HOSTS=

# Governed isolated analyzers and signed job callbacks.
ANALYZER_SHARED_TOKEN=replace-with-at-least-32-random-bytes
ANALYZER_OBJECT_STORE_HOSTS=
MULTIMODAL_ANALYZER_BASE_URL=
MULTIMODAL_ANALYZER_ALLOWED_HOSTS=
MULTIMODAL_ANALYZER_ALLOWED_PRIVATE_HOSTS=
MEDIA_ANALYZER_BASE_URL=
MEDIA_ANALYZER_ALLOWED_HOSTS=
MEDIA_ANALYZER_ALLOWED_PRIVATE_HOSTS=
# Multimodal cost/latency/recall controls. Empty frame interval uses the adaptive planner.
MULTIMODAL_FRAME_BATCH_SIZE=4
MULTIMODAL_FRAME_INTERVAL_MS=
MULTIMODAL_MAX_FRAMES=10000
MULTIMODAL_MIN_CONFIDENCE=0.35
MULTIMODAL_REVIEW_THRESHOLD=0.65
MULTIMODAL_BLOCK_THRESHOLD=0.8
MULTIMODAL_CROSS_MODAL_WINDOW_MS=30000
CALLBACK_ALLOWED_HOSTS=
CALLBACK_ALLOWED_PRIVATE_HOSTS=
TOOL_ALLOWED_HOSTS=
TOOL_ALLOWED_PRIVATE_HOSTS=
RAW_CONTENT_STORAGE_ENABLED=false
RAW_CONTENT_RETENTION_DAYS=7
CONTENT_PURGE_BATCH_SIZE=500
# HMAC key for exact batch deletion evidence; rotate with a stable key identifier.
DELETION_PROOF_HMAC_KEY=replace-with-at-least-32-random-bytes
DELETION_PROOF_HMAC_KEY_ID=deletion-proof-hmac-v1
# Automatic incident SLA for blocked detection sessions.
INCIDENT_AUTO_CREATE_SLA_MINUTES=60

# Optional edge appliance profile: docker compose --profile appliance up -d
APPLIANCE_AGENT_CONFIG_PATH=
APPLIANCE_AGENT_AUTH_TOKEN=
APPLIANCE_AGENT_PORT=8091

# Java gateway local concurrency bulkheads. Distributed request/token quotas use Redis;
# strict cluster-wide concurrency still requires the target gateway/Redis lease profile.
GUARD_CONCURRENCY_ENABLED=true
GUARD_MAX_IN_FLIGHT=200
GUARD_TENANT_MAX_IN_FLIGHT=200
GUARD_APPLICATION_MAX_IN_FLIGHT=100
GUARD_PRINCIPAL_MAX_IN_FLIGHT=20
GUARD_CREDENTIAL_MAX_IN_FLIGHT=50
GUARD_API_MAX_IN_FLIGHT=200
GUARD_CONCURRENCY_MAX_TRACKED_SCOPES=10000
GUARD_DISTRIBUTED_CONCURRENCY_ENABLED=true
GUARD_DISTRIBUTED_CONCURRENCY_FAIL_CLOSED=true
GUARD_DISTRIBUTED_CONCURRENCY_LEASE_TTL=30s
# JSON array only; executable must be absolute and placeholders appear exactly once.
# Example: ["/opt/guard/bin/document-converter","--input","{input}","--output","{output}"]
DOCUMENT_CONVERTER_COMMAND_JSON=
# Production defaults to mandatory two-person approval when this is unset.
EXPORT_APPROVAL_REQUIRED=true
