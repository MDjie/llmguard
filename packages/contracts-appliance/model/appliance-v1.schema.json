{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardllm:contracts:appliance:v1",
  "title": "GuardLLM Appliance Protocol V1",
  "description": "Canonical contract between an appliance network data plane, inspection fabric, device agents and evidence consumers.",
  "x-grpc-services": {
    "ApplianceInspectionService": {
      "OpenFlow": {
        "request": "FlowEnvelope",
        "response": "FlowAdmission",
        "requestStream": false,
        "responseStream": false
      },
      "InspectFrame": {
        "request": "FrameEnvelope",
        "response": "EnforcementDecision",
        "requestStream": true,
        "responseStream": true
      },
      "CompleteArtifact": {
        "request": "ArtifactEnvelope",
        "response": "EnforcementDecision",
        "requestStream": false,
        "responseStream": false
      },
      "CloseFlow": {
        "request": "FlowClose",
        "response": "FlowReceipt",
        "requestStream": false,
        "responseStream": false
      },
      "RecordEnforcement": {
        "request": "EnforcementReceipt",
        "response": "ReceiptAck",
        "requestStream": false,
        "responseStream": false
      }
    },
    "ApplianceControlService": {
      "ReportCapability": {
        "request": "CapabilityManifest",
        "response": "CapabilityAck",
        "requestStream": false,
        "responseStream": false
      },
      "ReportHealth": {
        "request": "HealthSnapshot",
        "response": "HealthAck",
        "requestStream": true,
        "responseStream": true
      },
      "AckBundle": {
        "request": "BundleActivationReceipt",
        "response": "BundleAck",
        "requestStream": false,
        "responseStream": false
      }
    }
  },
  "$ref": "#/$defs/FlowEnvelope",
  "$defs": {
    "TransportProtocol": {
      "type": "string",
      "enum": ["TCP", "UDP"]
    },
    "ApplicationProtocol": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "TLS",
        "HTTP_1_1",
        "HTTP_2",
        "HTTPS",
        "SSE",
        "WEBSOCKET",
        "GRPC",
        "OPENAI_API",
        "MQTT",
        "MCP"
      ]
    },
    "TrafficDirection": {
      "type": "string",
      "enum": ["CLIENT_TO_SERVER", "SERVER_TO_CLIENT"]
    },
    "ProtocolStage": {
      "type": "string",
      "enum": [
        "FLOW_METADATA",
        "TLS_HANDSHAKE",
        "HEADERS",
        "MESSAGE",
        "ARTIFACT",
        "TRAILERS"
      ]
    },
    "DeploymentMode": {
      "type": "string",
      "enum": ["REVERSE_PROXY", "TRANSPARENT_INLINE", "TAP_MIRROR", "HA_PAIR"]
    },
    "AdmissionAction": {
      "type": "string",
      "enum": ["INSPECT", "ALLOW_METADATA_ONLY", "BLOCK", "MIRROR_ONLY"]
    },
    "EnforcementAction": {
      "type": "string",
      "enum": [
        "ALLOW",
        "BLOCK",
        "RESET",
        "RATE_LIMIT",
        "REDIRECT",
        "MASK",
        "REWRITE",
        "QUARANTINE",
        "MIRROR_ONLY"
      ]
    },
    "HealthAction": {
      "type": "string",
      "enum": ["HEALTHY", "DEGRADE", "DRAIN", "ISOLATE", "FAILOVER"]
    },
    "ReceiptStatus": {
      "type": "string",
      "enum": ["APPLIED", "REJECTED", "EXPIRED", "DUPLICATE"]
    },
    "BundleActivationStatus": {
      "type": "string",
      "enum": ["PREPARED", "ACTIVE", "REJECTED", "ROLLED_BACK"]
    },
    "EngineType": {
      "type": "string",
      "enum": [
        "FAST_PATH",
        "PROTOCOL_PROXY",
        "IPS",
        "ANTIVIRUS",
        "DOS",
        "DLP",
        "AI_GUARD",
        "FILE_ANALYZER",
        "HARDWARE_AGENT"
      ]
    },
    "NetworkEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip", "port"],
      "properties": {
        "ip": { "type": "string", "minLength": 2, "maxLength": 64 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "mac": { "type": "string", "pattern": "^[a-fA-F0-9]{2}(?::[a-fA-F0-9]{2}){5}$" },
        "zone": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "TlsContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intercepted", "version", "serverName", "peerCertificateSha256"],
      "properties": {
        "intercepted": { "type": "boolean" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "serverName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "alpn": { "type": "string", "minLength": 1, "maxLength": 64 },
        "cipherSuite": { "type": "string", "minLength": 1, "maxLength": 128 },
        "peerCertificateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "clientCertificateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "FlowEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "deviceId",
        "deviceGroupId",
        "flowId",
        "flowSeq",
        "tenantId",
        "applicationId",
        "deploymentMode",
        "ingressInterface",
        "egressInterface",
        "source",
        "destination",
        "transport",
        "applicationProtocol",
        "direction",
        "protectedTraffic",
        "openedAtEpochMs",
        "absoluteDeadlineEpochMs",
        "policyBundleId"
      ],
      "properties": {
        "contractVersion": { "type": "string", "const": "1.0" },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceGroupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "flowSeq": { "type": "integer", "minimum": 0 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "applicationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deploymentMode": { "$ref": "#/$defs/DeploymentMode" },
        "ingressInterface": { "type": "string", "minLength": 1, "maxLength": 128 },
        "egressInterface": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vlanId": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "source": { "$ref": "#/$defs/NetworkEndpoint" },
        "destination": { "$ref": "#/$defs/NetworkEndpoint" },
        "transport": { "$ref": "#/$defs/TransportProtocol" },
        "applicationProtocol": { "$ref": "#/$defs/ApplicationProtocol" },
        "direction": { "$ref": "#/$defs/TrafficDirection" },
        "protectedTraffic": { "type": "boolean" },
        "openedAtEpochMs": { "type": "integer", "minimum": 1 },
        "absoluteDeadlineEpochMs": { "type": "integer", "minimum": 1 },
        "policyBundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tls": { "$ref": "#/$defs/TlsContext" }
      }
    },
    "FlowAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowId", "flowSeq", "action", "reasonCode", "policyBundleId", "expiresAtEpochMs"],
      "properties": {
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "flowSeq": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/$defs/AdmissionAction" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policyBundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expiresAtEpochMs": { "type": "integer", "minimum": 1 }
      }
    },
    "ContentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "expiresAtEpochMs"],
      "properties": {
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authorizationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expiresAtEpochMs": { "type": "integer", "minimum": 1 }
      }
    },
    "FrameEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "flowId",
        "frameId",
        "flowSeq",
        "frameSeq",
        "direction",
        "applicationProtocol",
        "protocolStage",
        "mediaType",
        "sizeBytes",
        "sha256",
        "streamOffsetStart",
        "streamOffsetEnd",
        "absoluteDeadlineEpochMs",
        "policyBundleId"
      ],
      "properties": {
        "contractVersion": { "type": "string", "const": "1.0" },
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "frameId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "flowSeq": { "type": "integer", "minimum": 0 },
        "frameSeq": { "type": "integer", "minimum": 0 },
        "direction": { "$ref": "#/$defs/TrafficDirection" },
        "applicationProtocol": { "$ref": "#/$defs/ApplicationProtocol" },
        "protocolStage": { "$ref": "#/$defs/ProtocolStage" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contentEncoding": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 3221225472 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "streamOffsetStart": { "type": "integer", "minimum": 0 },
        "streamOffsetEnd": { "type": "integer", "minimum": 0 },
        "absoluteDeadlineEpochMs": { "type": "integer", "minimum": 1 },
        "policyBundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inlinePayloadBase64": { "type": "string", "maxLength": 5592408 },
        "contentReference": { "$ref": "#/$defs/ContentReference" }
      },
      "oneOf": [
        { "required": ["inlinePayloadBase64"] },
        { "required": ["contentReference"] }
      ]
    },
    "NetworkObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineId",
        "engineType",
        "engineVersion",
        "ruleVersion",
        "status",
        "riskType",
        "severity",
        "score",
        "evidenceDigest"
      ],
      "properties": {
        "engineId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "engineType": { "$ref": "#/$defs/EngineType" },
        "engineVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ruleVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["MATCH", "NO_MATCH", "TIMEOUT", "ERROR", "SKIPPED"] },
        "riskType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "maskedPreview": { "type": "string", "maxLength": 512 }
      }
    },
    "EnforcementDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "decisionId",
        "flowId",
        "frameId",
        "flowSeq",
        "frameSeq",
        "contentSha256",
        "action",
        "terminal",
        "reasonCode",
        "policyBundleId",
        "observations",
        "issuedAtEpochMs",
        "expiresAtEpochMs",
        "evidenceComplete",
        "enforcementToken"
      ],
      "properties": {
        "contractVersion": { "type": "string", "const": "1.0" },
        "decisionId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "frameId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "flowSeq": { "type": "integer", "minimum": 0 },
        "frameSeq": { "type": "integer", "minimum": 0 },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "action": { "$ref": "#/$defs/EnforcementAction" },
        "terminal": { "type": "boolean" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policyBundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "guardDecisionId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "observations": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/NetworkObservation" }
        },
        "issuedAtEpochMs": { "type": "integer", "minimum": 1 },
        "expiresAtEpochMs": { "type": "integer", "minimum": 1 },
        "evidenceComplete": { "type": "boolean" },
        "transformedPayloadBase64": { "type": "string", "maxLength": 5592408 },
        "enforcementToken": { "type": "string", "minLength": 32, "maxLength": 4096 }
      }
    },
    "EnforcementReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "decisionId",
        "deviceId",
        "flowId",
        "frameId",
        "action",
        "status",
        "executedAtEpochMs",
        "bytesForwardedBeforeDecision",
        "receiptDigest"
      ],
      "properties": {
        "receiptId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "decisionId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "frameId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "action": { "$ref": "#/$defs/EnforcementAction" },
        "status": { "$ref": "#/$defs/ReceiptStatus" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "executedAtEpochMs": { "type": "integer", "minimum": 1 },
        "bytesForwardedBeforeDecision": { "type": "integer", "minimum": 0 },
        "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "ArtifactEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "flowId",
        "frameId",
        "artifactId",
        "mediaType",
        "sizeBytes",
        "sha256",
        "contentReference",
        "absoluteDeadlineEpochMs",
        "policyBundleId"
      ],
      "properties": {
        "contractVersion": { "type": "string", "const": "1.0" },
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "frameId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "artifactId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 3221225472 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contentReference": { "$ref": "#/$defs/ContentReference" },
        "absoluteDeadlineEpochMs": { "type": "integer", "minimum": 1 },
        "policyBundleId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "FlowClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowId", "flowSeq", "closedAtEpochMs", "reasonCode"],
      "properties": {
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "flowSeq": { "type": "integer", "minimum": 0 },
        "closedAtEpochMs": { "type": "integer", "minimum": 1 },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "FlowReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowId", "flowSeq", "status", "closedAtEpochMs", "receiptDigest"],
      "properties": {
        "flowId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "flowSeq": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/ReceiptStatus" },
        "closedAtEpochMs": { "type": "integer", "minimum": 1 },
        "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "EngineCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "engineType", "version", "artifactSha256", "protocols", "actions"],
      "properties": {
        "engineId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "engineType": { "$ref": "#/$defs/EngineType" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ApplicationProtocol" }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EnforcementAction" }
        }
      }
    },
    "HardwareCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuArchitecture",
        "cpuModel",
        "memoryBytes",
        "nicModels",
        "acceleratorModels",
        "driverDigests",
        "firmwareDigests",
        "physicalBypassAvailable",
        "trustedKeyDeviceAvailable"
      ],
      "properties": {
        "cpuArchitecture": { "type": "string", "minLength": 1, "maxLength": 64 },
        "cpuModel": { "type": "string", "minLength": 1, "maxLength": 256 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "nicModels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "acceleratorModels": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "driverDigests": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
        "firmwareDigests": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
        "physicalBypassAvailable": { "type": "boolean" },
        "trustedKeyDeviceAvailable": { "type": "boolean" }
      }
    },
    "CapabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "deviceId",
        "deviceGroupId",
        "generation",
        "reportedAtEpochMs",
        "softwareVersion",
        "softwareDigest",
        "deploymentModes",
        "engines",
        "hardware",
        "manifestDigest"
      ],
      "properties": {
        "contractVersion": { "type": "string", "const": "1.0" },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceGroupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 1 },
        "reportedAtEpochMs": { "type": "integer", "minimum": 1 },
        "softwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "softwareDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "deploymentModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/DeploymentMode" }
        },
        "engines": { "type": "array", "items": { "$ref": "#/$defs/EngineCapability" } },
        "hardware": { "$ref": "#/$defs/HardwareCapability" },
        "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "HealthComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "action", "reasonCodes"],
      "properties": {
        "componentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "$ref": "#/$defs/HealthAction" },
        "reasonCodes": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "utilization": { "type": "number", "minimum": 0, "maximum": 1 },
        "queueDepth": { "type": "integer", "minimum": 0 },
        "temperatureCelsius": { "type": "number", "minimum": -100, "maximum": 250 }
      }
    },
    "HealthSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "generation", "capturedAtEpochMs", "action", "components", "snapshotDigest"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 1 },
        "capturedAtEpochMs": { "type": "integer", "minimum": 1 },
        "action": { "$ref": "#/$defs/HealthAction" },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/HealthComponent" } },
        "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "BundleActivationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "bundleId",
        "generation",
        "bundleDigest",
        "status",
        "componentDigests",
        "recordedAtEpochMs",
        "receiptDigest"
      ],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 1 },
        "bundleDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": { "$ref": "#/$defs/BundleActivationStatus" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "componentDigests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "recordedAtEpochMs": { "type": "integer", "minimum": 1 },
        "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "NetworkBypassPermitPayloadV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "permitId",
        "deviceGroupId",
        "tenantId",
        "applicationId",
        "portPairs",
        "protocols",
        "maximumConnections",
        "maximumBytes",
        "reason",
        "changeTicketId",
        "approverIds",
        "policyBundleId",
        "issuedAtEpochMs",
        "expiresAtEpochMs"
      ],
      "properties": {
        "version": { "type": "string", "const": "2.0" },
        "permitId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "deviceGroupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "applicationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "portPairs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "protocols": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/ApplicationProtocol" } },
        "maximumConnections": { "type": "integer", "minimum": 1 },
        "maximumBytes": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 8, "maxLength": 1024 },
        "changeTicketId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approverIds": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "policyBundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "issuedAtEpochMs": { "type": "integer", "minimum": 1 },
        "expiresAtEpochMs": { "type": "integer", "minimum": 1 }
      }
    },
    "SignedNetworkBypassPermitV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "payload", "signature"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "algorithm": { "type": "string", "const": "Ed25519" },
        "payload": { "$ref": "#/$defs/NetworkBypassPermitPayloadV2" },
        "signature": { "type": "string", "minLength": 64, "maxLength": 4096 }
      }
    },
    "CapabilityAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "generation", "accepted", "reasonCode"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 1 },
        "accepted": { "type": "boolean" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "HealthAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "generation", "accepted", "requiredAction"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 1 },
        "accepted": { "type": "boolean" },
        "requiredAction": { "$ref": "#/$defs/HealthAction" }
      }
    },
    "BundleAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "bundleId", "generation", "accepted", "reasonCode"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 1 },
        "accepted": { "type": "boolean" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "ReceiptAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "accepted", "reasonCode"],
      "properties": {
        "receiptId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "accepted": { "type": "boolean" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
