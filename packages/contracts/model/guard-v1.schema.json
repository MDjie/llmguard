{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardllm:contracts:guard:v1",
  "title": "GuardLLM Guard Protocol V1",
  "description": "Canonical cross-language contract for online, evaluation, replay and event consumers.",
  "x-grpc-services": {
    "GuardService": {
      "Evaluate": {
        "request": "GuardRequest",
        "response": "GuardDecision",
        "requestStream": false,
        "responseStream": false
      },
      "EvaluateStream": {
        "request": "GuardRequest",
        "response": "GuardDecision",
        "requestStream": true,
        "responseStream": true
      }
    }
  },
  "$ref": "#/$defs/GuardRequest",
  "$defs": {
    "Direction": {
      "type": "string",
      "enum": [
        "INPUT",
        "OUTPUT_COMPLETE",
        "OUTPUT_CHUNK",
        "RAG_INGEST",
        "RAG_CONTEXT",
        "TOOL_REQUEST",
        "TOOL_RESULT"
      ]
    },
    "GuardAction": {
      "type": "string",
      "enum": [
        "ALLOW",
        "WARN",
        "BLOCK",
        "MASK",
        "REWRITE",
        "SAFE_RESPONSE",
        "REQUIRE_REVIEW"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "NONE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "ObservationStatus": {
      "type": "string",
      "enum": [
        "MATCH",
        "NO_MATCH",
        "TIMEOUT",
        "ERROR",
        "SKIPPED"
      ]
    },
    "ContextRole": {
      "type": "string",
      "enum": [
        "mention",
        "quotation",
        "news",
        "legal",
        "research",
        "education",
        "medical",
        "instruction",
        "transaction",
        "endorsement",
        "disclosure"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "TEXT",
        "IMAGE",
        "AUDIO",
        "VIDEO",
        "DOCUMENT",
        "TOOL_RESULT",
        "RAG_CHUNK"
      ]
    },
    "SourceType": {
      "type": "string",
      "enum": [
        "SYSTEM",
        "USER",
        "RAG",
        "TOOL",
        "MEMORY",
        "AGENT",
        "FILE",
        "MEDIA"
      ]
    },
    "TrustLevel": {
      "type": "string",
      "enum": [
        "TRUSTED",
        "CONTROLLED",
        "UNTRUSTED"
      ]
    },
    "InstructionCapability": {
      "type": "string",
      "enum": [
        "ALLOWED",
        "DATA_ONLY",
        "FORBIDDEN"
      ]
    },
    "GuardFailMode": {
      "type": "string",
      "enum": [
        "NORMAL",
        "FAIL_CLOSED",
        "DEGRADED",
        "FAIL_OPEN"
      ]
    },
    "ProcessingStage": {
      "type": "string",
      "enum": [
        "INPUT_PRE",
        "MODEL_PRE",
        "MODEL_STREAM",
        "OUTPUT_POST",
        "RAG_INGEST",
        "RAG_RETRIEVE",
        "TOOL_PRE",
        "TOOL_POST",
        "MEDIA_ANALYZE",
        "OFFLINE_EVALUATE"
      ]
    },
    "SideEffect": {
      "type": "string",
      "enum": [
        "NONE",
        "READ",
        "WRITE",
        "EXECUTE",
        "EXTERNAL_COMMUNICATION",
        "FINANCIAL",
        "PRIVILEGE_CHANGE"
      ]
    },
    "ContextEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelopeId",
        "tenantId",
        "applicationId",
        "sourceType",
        "sourceId",
        "trustLevel",
        "instructionCapability",
        "sensitivityLabels",
        "contentHash",
        "parentEnvelopeIds",
        "policyVersion",
        "eventSeq",
        "contentStart",
        "contentEnd"
      ],
      "properties": {
        "envelopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modality": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "timeRangeMs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "region": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "sourceType": {
          "$ref": "#/$defs/SourceType"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trustLevel": {
          "$ref": "#/$defs/TrustLevel"
        },
        "instructionCapability": {
          "$ref": "#/$defs/InstructionCapability"
        },
        "sensitivityLabels": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parentEnvelopeIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "eventSeq": {
          "type": "integer",
          "minimum": 0
        },
        "contentStart": {
          "type": "integer",
          "minimum": 0
        },
        "contentEnd": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAtEpochMs": {
          "type": "integer",
          "minimum": 1
        },
        "signature": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "signatureKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ActionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "userGoal",
        "toolName",
        "parametersDigest",
        "targetResource",
        "sideEffect",
        "requiredPermissions",
        "supportingEnvelopeIds",
        "dataDestinations",
        "riskBudget"
      ],
      "properties": {
        "intentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "userGoal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "toolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parametersDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetResource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sideEffect": {
          "$ref": "#/$defs/SideEffect"
        },
        "requiredPermissions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "supportingEnvelopeIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "dataDestinations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "riskBudget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expiresAtEpochMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceId",
        "requestId",
        "tenantId",
        "applicationId",
        "direction",
        "absoluteDeadlineEpochMs",
        "policyBundleId"
      ],
      "properties": {
        "traceId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceType": {
          "$ref": "#/$defs/SourceType"
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "industry": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "absoluteDeadlineEpochMs": {
          "type": "integer",
          "minimum": 1
        },
        "policyBundleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authContextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tokenizerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stage": {
          "$ref": "#/$defs/ProcessingStage"
        },
        "businessLine": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "legalDisclaimerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "taskPurpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "User-requested task context. It does not grant permissions or override source trust."
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind",
        "mediaType",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3221225472
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "GuardContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "envelopes": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/ContextEnvelope"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "artifacts"
          ]
        }
      ]
    },
    "GuardRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "context",
        "content"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "context": {
          "$ref": "#/$defs/RequestContext"
        },
        "content": {
          "$ref": "#/$defs/GuardContent"
        },
        "actionIntent": {
          "$ref": "#/$defs/ActionIntent"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewId",
        "contentHmac"
      ],
      "properties": {
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "region": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "timeRangeMs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "maskedPreview": {
          "type": "string",
          "maxLength": 512
        },
        "contentHmac": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceEnvelopeIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "tokenStart": {
          "type": "integer",
          "minimum": 0
        },
        "tokenEnd": {
          "type": "integer",
          "minimum": 0
        },
        "tokenizerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "normalizedStart": {
          "type": "integer",
          "minimum": 0
        },
        "normalizedEnd": {
          "type": "integer",
          "minimum": 0
        },
        "normalizationTransforms": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceLocation"
          },
          "maxItems": 1000
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detectorId",
        "detectorVersion",
        "riskType",
        "score",
        "severity",
        "evidence",
        "status"
      ],
      "properties": {
        "detectorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "detectorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "riskType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dictionaryReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dictionaryVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "severity": {
          "$ref": "#/$defs/RiskLevel"
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "status": {
          "$ref": "#/$defs/ObservationStatus"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "failMode": {
          "$ref": "#/$defs/GuardFailMode"
        },
        "canonicalTermId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "variantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dictionaryLayer": {
          "type": "string",
          "enum": [
            "PLATFORM_REDLINE",
            "INDUSTRY",
            "TENANT",
            "APPLICATION",
            "INCIDENT"
          ]
        },
        "contextRole": {
          "$ref": "#/$defs/ContextRole"
        },
        "decisionRole": {
          "type": "string",
          "enum": [
            "HARD_DENY",
            "CANDIDATE",
            "CONFIRMED_RISK",
            "CLEARED",
            "UNKNOWN"
          ]
        },
        "semanticCoverage": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNSUPPORTED",
            "NOT_APPLICABLE"
          ]
        },
        "assessmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scoreMeaning": {
          "type": "string",
          "enum": [
            "PROBABILITY",
            "POLICY",
            "UNCALIBRATED"
          ]
        }
      }
    },
    "LatencyBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalMs"
      ],
      "properties": {
        "normalizationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "detectionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "aggregationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "interventionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "totalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "GuardDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "decisionId",
        "traceId",
        "action",
        "riskLevel",
        "observations",
        "policyPath",
        "bundleId",
        "latencyMs",
        "degradationReasons"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "decisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "traceId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "action": {
          "$ref": "#/$defs/GuardAction"
        },
        "riskLevel": {
          "$ref": "#/$defs/RiskLevel"
        },
        "observations": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "policyPath": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "bundleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "latencyBreakdown": {
          "$ref": "#/$defs/LatencyBreakdown"
        },
        "degraded": {
          "type": "boolean"
        },
        "reasonCodes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "degradationReasons": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "transformedText": {
          "type": "string",
          "maxLength": 1048576
        },
        "modelVersions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "failMode": {
          "$ref": "#/$defs/GuardFailMode"
        },
        "evidenceComplete": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "compliance": {
          "$ref": "#/$defs/ComplianceContext"
        },
        "transform": {
          "$ref": "#/$defs/DecisionTransform"
        }
      }
    },
    "GuardError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "code",
        "message",
        "traceId",
        "retryable"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "code": {
          "type": "string",
          "pattern": "^GRD_[A-Z0-9_]+$",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "traceId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "GuardEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "eventId",
        "eventType",
        "occurredAt",
        "traceId",
        "tenantId",
        "applicationId",
        "payload"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "eventType": {
          "type": "string",
          "enum": [
            "GUARD_REQUEST_ACCEPTED",
            "OBSERVATION_RECORDED",
            "DECISION_RECORDED",
            "ARTIFACT_STATE_CHANGED",
            "POLICY_BUNDLE_ACTIVATED"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "traceId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/GuardRequest"
            },
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "$ref": "#/$defs/GuardDecision"
            },
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "$ref": "#/$defs/ContextEnvelope"
            },
            {
              "$ref": "#/$defs/ActionIntent"
            }
          ]
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAtEpochMs": {
          "type": "integer",
          "minimum": 1
        },
        "signature": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "signatureKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "DlpTransformOperation": {
      "type": "string",
      "enum": [
        "PARTIAL_MASK",
        "FULL_MASK",
        "TOKENIZE",
        "REDACT",
        "BLOCK"
      ]
    },
    "DecisionTransformType": {
      "type": "string",
      "enum": [
        "MASK",
        "REWRITE",
        "SAFE_RESPONSE",
        "REQUIRE_REVIEW",
        "BLOCK"
      ]
    },
    "DecisionTransformRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "operation",
        "start",
        "end",
        "outputStart",
        "outputEnd",
        "maskedPreview",
        "contentHmac"
      ],
      "properties": {
        "entityType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "$ref": "#/$defs/DlpTransformOperation"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "outputStart": {
          "type": "integer",
          "minimum": 0
        },
        "outputEnd": {
          "type": "integer",
          "minimum": 0
        },
        "maskedPreview": {
          "type": "string",
          "maxLength": 512
        },
        "contentHmac": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "DecisionTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ranges",
        "outputHash"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/DecisionTransformType"
        },
        "ranges": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DecisionTransformRange"
          }
        },
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "templateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "outputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recheckDecisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ComplianceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "jurisdiction",
        "industry",
        "businessLine",
        "policyVersion",
        "legalDisclaimerVersion"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "industry": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "businessLine": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "legalDisclaimerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "EvidenceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "sourceDigest",
        "contentVersion",
        "contentPath",
        "mappingVersion",
        "offsetEncoding"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contentPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mappingVersion": {
          "type": "string",
          "const": "guard-evidence-location-1"
        },
        "offsetEncoding": {
          "type": "string",
          "const": "UTF16"
        },
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "textStart": {
          "type": "integer",
          "minimum": 0
        },
        "textEnd": {
          "type": "integer",
          "minimum": 0
        },
        "textLength": {
          "type": "integer",
          "minimum": 0
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0
        },
        "channel": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "speakerId": {
          "type": "string",
          "maxLength": 128
        },
        "region": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
