          "tenantId",
          "applicationId",
          "payload"
        ],
        "properties": {
          "contractVersion": {
            "type": "string",
            "const": "1.0"
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "eventType": {
            "type": "string",
            "enum": [
              "GUARD_REQUEST_ACCEPTED",
              "OBSERVATION_RECORDED",
              "DECISION_RECORDED",
              "ARTIFACT_STATE_CHANGED",
              "POLICY_BUNDLE_ACTIVATED"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "traceId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "applicationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "payload": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GuardRequest"
              },
              {
                "$ref": "#/components/schemas/Observation"
              },
              {
                "$ref": "#/components/schemas/GuardDecision"
              },
              {
                "$ref": "#/components/schemas/ArtifactRef"
              },
              {
                "$ref": "#/components/schemas/ContextEnvelope"
              },
              {
                "$ref": "#/components/schemas/ActionIntent"
              }
            ]
          },
          "sequenceNumber": {
            "type": "integer",
            "minimum": 0
          },
          "expiresAtEpochMs": {
            "type": "integer",
            "minimum": 1
          },
          "signature": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096
          },
          "signatureKeyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "DlpTransformOperation": {
        "type": "string",
        "enum": [
          "PARTIAL_MASK",
          "FULL_MASK",
          "TOKENIZE",
          "REDACT",
          "BLOCK"
        ]
      },
      "DecisionTransformType": {
        "type": "string",
        "enum": [
          "MASK",
          "REWRITE",
          "SAFE_RESPONSE",
          "REQUIRE_REVIEW",
          "BLOCK"
        ]
      },
      "DecisionTransformRange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityType",
          "operation",
          "start",
          "end",
          "outputStart",
          "outputEnd",
          "maskedPreview",
          "contentHmac"
        ],
        "properties": {
          "entityType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation": {
            "$ref": "#/components/schemas/DlpTransformOperation"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "outputStart": {
            "type": "integer",
            "minimum": 0
          },
          "outputEnd": {
            "type": "integer",
            "minimum": 0
          },
          "maskedPreview": {
            "type": "string",
            "maxLength": 512
          },
          "contentHmac": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "DecisionTransform": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ranges",
          "outputHash"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DecisionTransformType"
          },
          "ranges": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/DecisionTransformRange"
            }
          },
          "templateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "templateVersion": {
            "type": "integer",
            "minimum": 1
          },
          "outputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recheckDecisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "ComplianceContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "jurisdiction",
          "industry",
          "businessLine",
          "policyVersion",
          "legalDisclaimerVersion"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128
          },
          "industry": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128
          },
          "businessLine": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128
          },
          "policyVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "legalDisclaimerVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "EvidenceLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "sourceDigest",
          "contentVersion",
          "contentPath",
          "mappingVersion",
          "offsetEncoding"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contentVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "contentPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "mappingVersion": {
            "type": "string",
            "const": "guard-evidence-location-1"
          },
          "offsetEncoding": {
            "type": "string",
            "const": "UTF16"
          },
          "viewId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "textStart": {
            "type": "integer",
            "minimum": 0
          },
          "textEnd": {
            "type": "integer",
            "minimum": 0
          },
          "textLength": {
            "type": "integer",
            "minimum": 0
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "frameIndex": {
            "type": "integer",
            "minimum": 0
          },
          "channel": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "speakerId": {
            "type": "string",
            "maxLength": 128
          },
          "region": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
