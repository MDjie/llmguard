          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuardRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guard decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardDecision"
                }
              }
            }
          },
          "default": {
            "description": "Guard protocol error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            }
          }
        }
      }
    }
  },
