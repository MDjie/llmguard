{
  "name": "projects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "policy:keygen": "tsx scripts/generate-policy-signing-key.ts",
    "policy:bootstrap": "tsx scripts/bootstrap-policy-bundle.ts --allow-local-development",
    "build": "next build",
    "contracts:check": "node packages/contracts/scripts/generate.mjs --check && node packages/contracts/scripts/check-compatibility.mjs && pnpm appliance:contracts:check",
    "contracts:generate": "node packages/contracts/scripts/generate.mjs && pnpm appliance:contracts:generate",
    "appliance:contracts:check": "node packages/contracts-appliance/scripts/generate.mjs --check && node packages/contracts-appliance/scripts/check-compatibility.mjs",
    "appliance:contracts:generate": "node packages/contracts-appliance/scripts/generate.mjs",
    "appliance:plan-check": "node scripts/acceptance/validate-appliance-plan.mjs",
    "appliance:validate": "node scripts/acceptance/run-appliance-baseline.mjs && pnpm production-surface:verify",
    "production-surface:verify": "node scripts/verify-production-surface.mjs",
    "dev": "node ./scripts/dev.mjs",
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "lint": "eslint .",
    "lint:build": "eslint . --quiet",
    "quality:full": "pnpm ts-check && pnpm lint:build",
    "quality:ratchet": "node ./scripts/check-quality-baseline.mjs",
    "secrets:migrate": "tsx scripts/migrate-provider-secrets.ts",
    "data:purge": "tsx scripts/purge-expired-content.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "audit:export-worker": "tsx scripts/audit-export-worker.ts",
    "audit:timestamp-worker": "tsx scripts/audit-timestamp-worker.ts",
    "evaluation:worker": "tsx scripts/evaluation-worker.ts",
    "security-scan:worker": "tsx scripts/security-scan-worker.ts",
    "artifact:worker": "tsx scripts/artifact-verifier-worker.ts",
    "acceptance:trace": "node scripts/acceptance/generate-traceability.mjs",
    "acceptance:audit": "node scripts/acceptance/audit-requirements.mjs",
    "acceptance:code": "node scripts/acceptance/run-pocs.mjs",
    "compatibility:check": "node scripts/compatibility/validate-matrix.mjs",
    "performance:validate-report": "node scripts/acceptance/validate-performance-report.mjs",
    "plan:check": "node scripts/acceptance/validate-integrated-plan.mjs && pnpm appliance:plan-check",
    "multimodal:worker": "tsx scripts/document-image-worker.ts",
    "media:worker": "tsx scripts/audio-video-worker.ts",
    "content-marking:worker": "tsx scripts/content-marking-worker.ts",
    "lexicon:verify-sources": "node scripts/content-safety/verify-source-lock.mjs",
    "lexicon:validate": "node scripts/content-safety/validate-lexicon.mjs",
    "lexicon:validate-production": "node scripts/content-safety/validate-lexicon.mjs --production",
    "lexicon:import-candidates": "node scripts/content-safety/import-candidates.mjs",
    "lexicon:compile-shadow": "node scripts/content-safety/compile-shadow-bundle.mjs",
    "lexicon:generate-hard-negatives": "node scripts/content-safety/generate-hard-negatives.mjs",
    "lexicon:evaluate-shadow": "tsx scripts/content-safety/evaluate-shadow.ts",
    "analyzer:start": "tsx services/media-analyzer/src/server.ts",
    "analyzer:build": "tsup --config services/media-analyzer/tsup.config.ts",
    "appliance-agent:start": "tsx services/appliance-agent/src/server.ts",
    "appliance-agent:build": "tsup --config services/appliance-agent/tsup.config.ts",
    "rag:worker": "tsx scripts/rag-ingest-worker.ts",
    "callback:worker": "tsx scripts/callback-dispatcher-worker.ts",
    "start": "node ./scripts/start.mjs",
    "test": "vitest --config vitest.config.mts",
    "test:unit": "vitest --config vitest.config.mts",
    "test:coverage": "vitest --config vitest.config.mts --run --coverage",
    "test:e2e": "playwright test",
    "test:contract": "vitest --config vitest.config.mts tests/contracts",
    "test:integration": "node scripts/integration/run-database-tests.mjs",
    "test:sdk-python": "python -m unittest discover -s packages/sdk-python/tests -p test_*.py",
    "test:sdk-go": "cd packages/sdk-go && go test ./...",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm contracts:check && pnpm plan:check && pnpm quality:full && pnpm test:unit --run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "16.3.3",
