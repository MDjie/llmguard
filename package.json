    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "2.112.4",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "ipaddr.js": "2.5.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "2.2.4",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "node-gyp-build": "4.8.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "postgres": "^3.4.9",
    "re2-wasm": "1.0.2",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-resizable-panels": "^4.2.0",
    "recharts": "2.15.4",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "hono": "^4.13.5",
    "shadcn": "3.7.0",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "4.1.11",
    "webpack": "^5.110.2"
  },
  "packageManager": "pnpm@11.19.0",
