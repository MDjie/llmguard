[Unit]
Description=GuardLLM worker %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/guardllm/runtime.env
ExecStartPre=/usr/local/libexec/guardllm-verify-image worker
ExecStart=/usr/bin/podman run --rm --name guardllm-worker-%i --network guardllm --read-only --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=1g --env-file /etc/guardllm/runtime.env ${GUARDLLM_WORKER_IMAGE} node --import tsx scripts/run-worker.mjs %i
ExecStop=/usr/bin/podman stop --time 45 guardllm-worker-%i
Restart=always
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=guardllm.target
