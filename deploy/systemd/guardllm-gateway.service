[Unit]
Description=GuardLLM security gateway
After=network-online.target guardllm-app.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/guardllm/runtime.env
ExecStartPre=/usr/local/libexec/guardllm-verify-image gateway
ExecStart=/usr/bin/podman run --rm --name guardllm-gateway --network guardllm --read-only --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=256m --env-file /etc/guardllm/runtime.env -p 0.0.0.0:8080:8080 ${GUARDLLM_GATEWAY_IMAGE}
ExecStop=/usr/bin/podman stop --time 45 guardllm-gateway
Restart=always
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=guardllm.target
