# Configure on the application server. Never commit actual credentials.
IAM_OIDC_ISSUER=https://identity.example.com/realms/guardllm
IAM_OIDC_CLIENT_ID=guardllm-console
IAM_OIDC_CLIENT_SECRET=
IAM_OIDC_REDIRECT_URI=https://guardllm.example.com/api/auth/oidc/callback
# Must map to an enforced Keycloak two-factor flow; a static claim mapper is unsafe.
IAM_OIDC_MFA_ACR=guardllm-mfa
# Enable after the three administrative users are bound and verified.
IAM_ENTERPRISE_LOGIN_REQUIRED=true
SESSION_COOKIE_SECURE=true
IAM_OIDC_ALLOW_LOCAL_HTTP=false
