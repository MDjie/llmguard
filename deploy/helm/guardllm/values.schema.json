{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "images",
    "workloads",
    "namespaces",
    "gatewayGrpc",
    "policyVerification"
  ],
  "properties": {
    "images": {
      "type": "object",
      "required": [
        "app",
        "gateway",
        "worker",
        "analyzer"
      ],
      "properties": {
        "app": {
          "$ref": "#/$defs/image"
        },
        "gateway": {
          "$ref": "#/$defs/image"
        },
        "worker": {
          "$ref": "#/$defs/image"
        },
        "analyzer": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "workloads": {
      "type": "object",
      "minProperties": 2
    },
    "namespaces": {
      "type": "object",
      "minProperties": 7
    },
    "gatewayGrpc": {
      "type": "object",
      "required": [
        "enabled",
        "port",
        "tlsRequired",
        "secretName",
        "mountPath"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tlsRequired": {
          "const": true
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "policyVerification": {
      "type": "object",
      "required": [
        "secretName",
        "publicKeySecretKey",
        "publicKeyFile",
        "mountPath",
        "signingKeyId"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "publicKeySecretKey": {
          "type": "string",
          "minLength": 1
        },
        "publicKeyFile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "signingKeyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "deploymentTopology": {
      "type": "object",
      "required": [
        "site",
        "zoneWhenUnsatisfiable",
        "zoneMinDomains"
      ],
      "properties": {
        "site": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "zoneWhenUnsatisfiable": {
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        },
        "zoneMinDomains": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
