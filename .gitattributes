# Third-party source-lock inputs must remain byte-for-byte identical to upstream files.
/data/content-safety/sources/raw/** -text -diff

# Keep the bilingual catalog and checksum-locked candidates portable across checkouts.
/data/content-safety/lexicon/prompt-injection-bilingual.v1.* text eol=lf

# Owned contract sources and generated digests use canonical LF on every platform.
/packages/contracts/** text=auto eol=lf
/packages/contracts-appliance/** text=auto eol=lf
/src/contracts/http/gateway-v2.ts text eol=lf
/services/guard-gateway/src/main/proto/** text eol=lf

# This lockfile is byte-hashed by the integrated acceptance manifest.
/pnpm-lock.yaml text eol=lf

# Preserve byte-hashed detection acceptance snapshots across checkouts.
/输出/代码分析与升级/2[6-9]_* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/输出/代码分析与升级/26_检测架构评审证据_2026-09-08/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/输出/测试报告/2026-09-08/detection-repair-*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Raw tool logs retain their original whitespace for checksum verification.
/输出/测试报告/2026-09-08/detection-repair-*/工程验收证据/*.log -whitespace

# Byte-hashed synthetic media and delivery evidence must survive Windows checkouts.
/tests/fixtures/multiformat/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/multiformat/*.md text eol=lf
/tests/fixtures/multiformat/*.json text eol=lf
